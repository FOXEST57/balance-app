<?xml version="1.0" encoding="utf-8"?>
<!--
  Icône adaptative (Android 8.0+).
  Le lanceur applique lui-même le masque (rond, arrondi, etc.) : plus d'effet
  « carré à l'intérieur d'un rond ». Le premier plan est la jauge néon, le fond
  est un aplat sombre identique à celui de l'application.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
